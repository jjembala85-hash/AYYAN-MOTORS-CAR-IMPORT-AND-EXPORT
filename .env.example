# Postgres. Neon uses the HTTP driver automatically (host matches *.neon.tech);
# Supabase and any other Postgres go over TCP via postgres.js.
#
#   Docker:   postgresql://ayyan:ayyan@127.0.0.1:5432/ayyan   (docker compose up -d)
#   Neon:     postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres.xxx:pass@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#
# Required at build time as well as at runtime: the vehicle detail pages are
# statically generated, so `next build` reads the catalogue from this database.
DATABASE_URL=postgresql://ayyan:ayyan@127.0.0.1:5432/ayyan

# Redis, for the read-through cache in front of Postgres. Entirely optional:
# leave it unset and the app queries Postgres directly, which is the right
# setting for local development and for CI.
#
#   Docker:  redis://127.0.0.1:6379            (docker compose up -d)
#   Managed: rediss://default:pass@host:6379   (TLS — note the second "s")
#
# Ignored during `next build`; prerendering has nothing to gain from it.
REDIS_URL=

# Bump when the shape of a cached value changes — a new field on a vehicle, a
# different sort order — so entries written by the previous deploy are orphaned
# instead of deserialized into the wrong type. Defaults to "ayyan:v1".
CACHE_NAMESPACE=

# Absolute origin used to resolve Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "1" to expose the GraphiQL explorer at /api/graphql in production.
# It is always available in development.
ENABLE_GRAPHIQL=


# ---------------------------------------------------------------------------
# Admin panel  (/admin)
# ---------------------------------------------------------------------------

# Signs the admin session cookie. REQUIRED — sign-in throws without it, by
# design: a default value here would mean every deployment that forgot to set
# one shared a forgeable session secret. Minimum 32 characters. Generate with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing it signs everyone out, which is also how you revoke every session.
ADMIN_SESSION_SECRET=

# Create the first account with:
#   npm run admin:create -- --email you@example.com --name "Your Name" --owner


# --- Image uploads ---------------------------------------------------------
#
# With S3_BUCKET unset, uploads are written to public/uploads on the local
# filesystem. That is fine for development and for a VPS with a real disk, and
# it is REFUSED in production otherwise — on Vercel, Netlify and any serverless
# host the filesystem is read-only or wiped on deploy, so the photos would
# silently disappear. Set ALLOW_LOCAL_UPLOADS=1 only if this deployment truly
# has persistent storage.
ALLOW_LOCAL_UPLOADS=

# Cloudflare R2 is the chosen provider — see docs/storage.md for the click-path.
# Requests are signed in-process (SigV4), so any S3-compatible service works
# unchanged: R2, AWS S3, Supabase Storage, Backblaze B2, MinIO.
#
# Run `npm run storage:check` after filling these in. It does a real write /
# read / public-fetch / delete round trip and names the fix for each failure.

# The bucket name exactly as created in the R2 dashboard.
S3_BUCKET=

# ALWAYS "auto" for R2. (AWS wants the bucket's real region instead.)
S3_REGION=auto

# R2 S3 API endpoint — the dashboard shows it on the bucket's Settings tab.
# Shaped: https://<32-char-account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=

# From "Manage R2 API Tokens" — an Object Read & Write token scoped to this one
# bucket. The secret is shown exactly once, at creation.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Where visitors LOAD the photos from. On R2 this is never the same host as
# S3_ENDPOINT — that one is for signed writes and is not publicly readable, so
# leaving this blank means every photo 404s for visitors even though uploads
# succeed. Either:
#   r2.dev  — https://pub-<hash>.r2.dev   (enable "Public Development URL";
#             rate-limited and not for production, fine while testing)
#   custom  — https://images.ayyanmotorsltd.com   (connect a domain; do this
#             before launch — it is also what gets Cloudflare's CDN in front)
S3_PUBLIC_URL=
